# Supabase 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 앱 런타임용 (Transaction pooler, 6543)
DATABASE_URL=
# 마이그레이션용 (Session pooler, 5432)
DIRECT_URL=

# 카카오 직접 연동 ([앱 설정] > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=
# [카카오 로그인] > 보안 에서 Client Secret 을 사용하는 경우에만 입력
KAKAO_CLIENT_SECRET=

# 문서 15.2 — 어드민 공유 계정 1개. 해시는 `npm run admin:hash` 로 생성
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
